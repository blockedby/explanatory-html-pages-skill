<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_collab" targetNamespace="urn:local:example">
  <bpmn:message id="Reminder" name="Reminder message" />
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Operations" name="Operations" processRef="Process_ops" />
    <bpmn:participant id="Customer" name="Customer" />
    <bpmn:messageFlow id="Message_flow" name="Send reminder" sourceRef="Notify" targetRef="Customer" messageRef="Reminder" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ops" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Agent" name="Agent"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Wait</bpmn:flowNodeRef><bpmn:flowNodeRef>Notify</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Opened" />
    <bpmn:intermediateCatchEvent id="Wait" name="Wait one day"><bpmn:timerEventDefinition id="Timer"><bpmn:timeDuration>P1D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Notify" name="Notify customer" />
    <bpmn:endEvent id="End" name="Done" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Wait" />
    <bpmn:sequenceFlow id="F2" sourceRef="Wait" targetRef="Notify" />
    <bpmn:sequenceFlow id="F3" sourceRef="Notify" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Operations_di" bpmnElement="Operations" isHorizontal="true"><dc:Bounds x="80" y="80" width="640" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Agent_di" bpmnElement="Agent" isHorizontal="true"><dc:Bounds x="110" y="80" width="610" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Customer_di" bpmnElement="Customer" isHorizontal="true"><dc:Bounds x="80" y="390" width="640" height="100" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="180" y="162" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Wait_di" bpmnElement="Wait"><dc:Bounds x="290" y="162" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Notify_di" bpmnElement="Notify"><dc:Bounds x="400" y="140" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="580" y="162" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="216" y="180" /><di:waypoint x="290" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="326" y="180" /><di:waypoint x="400" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="500" y="180" /><di:waypoint x="580" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Message_flow_di" bpmnElement="Message_flow"><di:waypoint x="450" y="220" /><di:waypoint x="450" y="390" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
