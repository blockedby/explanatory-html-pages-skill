{
  "name": "explanatory-html-pages-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local build-time tooling for standalone documentation pages",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/document.mjs doctor",
    "build:examples": "node scripts/build-examples.mjs",
    "test": "node --test tests/core.test.mjs tests/build.test.mjs tests/svg.test.mjs tests/plantuml.test.mjs tests/bpmn.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "validate": "python3 scripts/validate.py"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bpmn-auto-layout": "1.3.0",
    "bpmn-js": "18.28.0",
    "bpmn-moddle": "10.2.0",
    "dompurify": "3.4.15",
    "jsdom": "30.1.0",
    "parse5": "8.0.1",
    "playwright": "1.63.0"
  }
}
