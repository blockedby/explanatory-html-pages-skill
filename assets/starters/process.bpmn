<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="ExpenseDefinitions" targetNamespace="urn:documentation:expense">
  <bpmn:process id="ExpenseReview" isExecutable="false">
    <bpmn:startEvent id="Submitted" name="Expense submitted"><bpmn:outgoing>Flow1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Review" name="Review expense evidence"><bpmn:incoming>Flow1</bpmn:incoming><bpmn:outgoing>Flow2</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="Record" name="Record review decision"><bpmn:incoming>Flow2</bpmn:incoming><bpmn:outgoing>Flow3</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="Recorded" name="Decision recorded"><bpmn:incoming>Flow3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow1" sourceRef="Submitted" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow2" sourceRef="Review" targetRef="Record" />
    <bpmn:sequenceFlow id="Flow3" sourceRef="Record" targetRef="Recorded" />
  </bpmn:process>
</bpmn:definitions>
